# TM Sonder Go server — Apple Containerization micro-VM image.
# Build: container build -t tm-sonder   (from repo root)
# Run:   container run --name tm-sonder -p 8797:8797 \
#          --volume /path/to/media:/media:ro --volume sonder-data:/data tm-sonder
FROM golang:1.25 AS build
WORKDIR /src
ARG VERSION=0.2.0-dev
ARG BUILD=container
COPY server/go.mod ./
RUN go mod download
COPY server/ ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build \
      -trimpath -ldflags "-s -w -X main.version=${VERSION} -X tm-sonder/server/internal/httpapi.Version=${VERSION} -X tm-sonder/server/internal/httpapi.Build=${BUILD}" \
      -o /out/sonder ./cmd/sonder

FROM alpine:3.20
ARG VERSION=0.2.0-dev
RUN apk add --no-cache ffmpeg ca-certificates tzdata && \
    addgroup -S sonder && adduser -S -G sonder sonder && \
    mkdir -p /data /media && chown -R sonder:sonder /data
LABEL org.opencontainers.image.title="TM-Sonder" \
      org.opencontainers.image.description="TM Sonder audiobook and media server" \
      org.opencontainers.image.version="${VERSION}"
COPY --from=build /out/sonder /sonder
COPY deploy/container-server.json /etc/sonder/server.json
COPY deploy/container-entrypoint.sh /entrypoint.sh
RUN chmod 0755 /entrypoint.sh
USER sonder
ENV SONDER_DATA_DIR=/data \
    SONDER_PORT=8797 \
    SONDER_CONFIG=/data/server.json
EXPOSE 8797
VOLUME ["/data", "/media"]
ENTRYPOINT ["/entrypoint.sh"]
