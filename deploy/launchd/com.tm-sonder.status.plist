<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tm-sonder.status</string>

    <key>ProgramArguments</key>
    <array>
        <string>__STATUS_APP_EXECUTABLE__</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>__STATUS_LOG_FILE__</string>
    <key>StandardErrorPath</key>
    <string>__STATUS_LOG_FILE__</string>
</dict>
</plist>
