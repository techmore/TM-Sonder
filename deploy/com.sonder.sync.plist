<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sonder.sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/seandolbec/Projects/TM-Sonder/bin/sonder-sync.sh</string>
    </array>
    <!-- Every 60s: no-op when NAS is down, applies queues + rescan when back -->
    <key>StartInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>/tmp/sonder-sync.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/sonder-sync.err</string>
</dict>
</plist>
