[Unit]
Description=TM Sonder media server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/TM-Sonder
ExecStart=%h/TM-Sonder/bin/sonder-linux-amd64 -config %h/.config/sonder/server.json
Restart=on-failure
RestartSec=5
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Optional protected media-client compatibility credentials. The file is not
# part of the repository; create it as %h/.config/sonder/bookplayer.env with
# mode 0600 when BookPlayer should use a stable login alias.
EnvironmentFile=-%h/.config/sonder/bookplayer.env

[Install]
WantedBy=default.target
